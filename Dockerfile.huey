# syntax=docker/dockerfile:1

FROM python:3.12-slim

WORKDIR /app

# Install Huey in runtime
RUN pip install --no-cache-dir huey requests

# Copy Huey files
COPY ["infra/app/", "."]

# Create huey_data directory and non-root user
RUN mkdir -p /app/huey_data && chown -R 1000:1000 /app/huey_data
RUN useradd -m -u 1000 worker && chown -R 1000:1000 /app

USER worker

ENV HUEY_QUEUE_PATH=/app/huey_data
ENV API_BASE_URL=http://insurance-api:8080
ENV INTERNAL_API_KEY=dev-api-key-change-in-production

# Use direct script approach per D-01, with -u for unbuffered stdout
CMD ["python", "-u", "huey_consumer.py"]